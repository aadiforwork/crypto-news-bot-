# ==================== TELEGRAM CONFIGURATION ====================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get from @userinfobot or by messaging your bot and checking updates
# PRIVATE CHAT: positive id (e.g. 919135909)
# GROUP / CHANNEL: NEGATIVE id (e.g. -5597836192 or -1001234567890).
#   Group id lene ke liye @RawDataBot ko group me add karo, ya BotFather me
#   /setprivacy -> Disable karke https://api.telegram.org/bot<TOKEN>/getUpdates dekho.
# MULTIPLE TARGETS: comma-separated list bhi de sakte ho (group + private dono):
#   TELEGRAM_CHAT_ID=-5597836192,919135909
TELEGRAM_CHAT_ID=your_chat_id_here

# ==================== LLM PROVIDER (Choose ONE - all FREE) ====================
# 
# 1. OLLAMA (RECOMMENDED - 100% LOCAL, NO ACCOUNT, NO LIMITS)
#    Install: winget install Ollama.Ollama
#    Run: ollama serve
#    Pull model: ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
#
# 2. GEMINI (FREE tier)
#    Get key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# 3. GROQ (FREE - very fast)
#    Get key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-20b
#
# 4. OPENROUTER (needs credits)
#    Get key: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta/muse-spark-1.3

# ==================== DEFAULT: OLLAMA (100% LOCAL, NO ACCOUNT) ====================
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==================== DATA SOURCES (No API keys needed) ====================
