# ==================== TELEGRAM CONFIGURATION ====================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get from @userinfobot or by messaging your bot and checking updates
TELEGRAM_CHAT_ID=your_chat_id_here

# ==================== LLM PROVIDER (Choose ONE - all FREE) ====================
# 
# 1. OLLAMA (RECOMMENDED - 100% LOCAL, NO ACCOUNT, NO LIMITS)
#    Install: winget install Ollama.Ollama
#    Run: ollama serve
#    Pull model: ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
#
# 2. GEMINI (1500 req/day FREE)
#    Get key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash
#
# 3. GROQ (FREE - very fast)
#    Get key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.1-8b-instant
#
# 4. OPENROUTER (needs credits)
#    Get key: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta/muse-spark-1.3

# ==================== DEFAULT: OLLAMA (100% LOCAL, NO ACCOUNT) ====================
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

