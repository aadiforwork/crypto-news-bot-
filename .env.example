# ==================== TELEGRAM CONFIGURATION ====================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get from @userinfobot or by messaging your bot and checking updates
TELEGRAM_CHAT_ID=your_chat_id_here

# ==================== LLM PROVIDER (Choose ONE - all FREE) ====================
# 
# 1. OLLAMA (RECOMMENDED - 100% LOCAL, NO ACCOUNT, NO LIMITS)
#    Install: winget install Ollama.Ollama
#    Run: ollama serve
#    Pull model: ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
#
# 2. GEMINI (FREE tier)
#    Get key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# 3. GROQ (FREE - very fast)
#    Get key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-20b
#
# 4. OPENROUTER (needs credits)
#    Get key: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta/muse-spark-1.3

# ==================== DEFAULT: OLLAMA (100% LOCAL, NO ACCOUNT) ====================
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==================== DATA SOURCES (No API keys needed) ====================
# Crypto RSS Feeds (free, no auth):
# - https://cointelegraph.com/rss
# - https://www.coindesk.com/arc/outboundfeeds/rss
# - https://decrypt.co/feed
# - https://cryptoslate.com/feed/
# - https://www.theblock.co/rss.xml
#
# Macro Economic Calendar (free, no auth):
# - Forex Factory Economic Calendar (High-Impact USD events only)

# ==================== WHATSAPP ALERTS (FREE via CallMeBot, optional) ====================
# Same alerts jo Telegram pe jaate hain, WhatsApp pe bhi bhejta hai.
# Setup (2 min, ek baar):
#   1. Phone me ye number contact me save karo: +34 644 53 78 37 (naam: CallMeBot)
#   2. Us contact ko WhatsApp pe ye message bhejo:  I allow callmebot to send me messages
#   3. Turant reply me apikey milega (e.g. 123456)
#   4. Neeche apna number (country code ke saath, bina +) aur apikey .env me daalo
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=91XXXXXXXXXX
WHATSAPP_APIKEY=tumhara_apikey_yahan

# Calendar download throttle (seconds) - 429 rate-limit se bachne ke liye, kam mat karo
# MACRO_FETCH_INTERVAL=3600